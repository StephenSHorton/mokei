{
  "name": "mokei",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Glass + clay design system and swappable 3D scenes. Install from git.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephenSHorton/mokei.git"
  },
  "exports": {
    ".": {
      "types": "./pkg/kit/index.d.ts",
      "default": "./pkg/kit/index.js"
    },
    "./theme": {
      "types": "./pkg/kit/theme/index.d.ts",
      "default": "./pkg/kit/theme/index.js"
    },
    "./theme/yardline": {
      "types": "./pkg/kit/theme/yardline.d.ts",
      "default": "./pkg/kit/theme/yardline.js"
    },
    "./theme/blank": {
      "types": "./pkg/kit/theme/blank.d.ts",
      "default": "./pkg/kit/theme/blank.js"
    },
    "./theme/quarry": {
      "types": "./pkg/kit/theme/quarry.d.ts",
      "default": "./pkg/kit/theme/quarry.js"
    },
    "./theme/tokens.css": "./pkg/kit/theme/tokens.css",
    "./theme/preset.css": "./pkg/kit/theme/preset.css",
    "./themes/yardline.css": "./pkg/kit/themes/yardline.css",
    "./themes/blank.css": "./pkg/kit/themes/blank.css",
    "./themes/quarry.css": "./pkg/kit/themes/quarry.css",
    "./scene": {
      "types": "./pkg/kit/scene/index.d.ts",
      "default": "./pkg/kit/scene/index.js"
    },
    "./scene/yardline": "./src/kit/scene/yardline.ts",
    "./scene/blank": {
      "types": "./pkg/kit/scene/blank.d.ts",
      "default": "./pkg/kit/scene/blank.js"
    },
    "./clay": {
      "types": "./pkg/kit/clay/index.d.ts",
      "default": "./pkg/kit/clay/index.js"
    }
  },
  "main": "./pkg/kit/index.js",
  "types": "./pkg/kit/index.d.ts",
  "files": [
    "pkg",
    "src/kit",
    "src/scenes",
    "src/lib/math.ts",
    "LICENSE",
    "README.md",
    "docs/SCENES.md",
    "docs/PRINCIPLES.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./pkg/kit/scene/blank.js",
    "./src/kit/scene/blank.ts",
    "./src/kit/scene/yardline.ts",
    "./pkg/kit/theme/yardline.js",
    "./pkg/kit/theme/blank.js",
    "./pkg/kit/theme/quarry.js",
    "./src/kit/theme/yardline.ts",
    "./src/kit/theme/blank.ts",
    "./src/kit/theme/quarry.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build:registry": "node scripts/build-registry.mjs",
    "build:kit": "node scripts/build-kit.mjs",
    "check:roles": "node scripts/check-theme-roles.mjs",
    "check:scene-bundle": "node scripts/check-scene-bundle.mjs",
    "build": "npm run build:registry && npm run build:kit && npm run check:roles && npm run check:scene-bundle && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.186.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@react-three/postprocessing": "^3.1.3",
    "@types/three": "^0.186.0",
    "postprocessing": "^6.39.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "leva": "^0.10.1",
    "lucide-react": "^1.51.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
