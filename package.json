{
  "name": "mokei",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Glass + clay design system and swappable 3D scenes. Not published to npm — install from git.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephenSHorton/mokei.git"
  },
  "exports": {
